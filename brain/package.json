{
  "name": "jarvis-brain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "prestart": "test -x ../native/bin/mic-capture -a -x ../native/bin/speak -a -x ../native/bin/JarvisUI || npm run build:native && ../scripts/fetch-models.sh >/dev/null",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts",
    "prespike": "test -x ../native/bin/mic-capture -a -x ../native/bin/speak -a -x ../native/bin/JarvisUI || npm run build:native",
    "spike": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/spike.ts",
    "build:native": "mkdir -p ../native/bin && cd ../native && for f in mic-capture speak JarvisUI; do xcrun swiftc -O -swift-version 5 $f.swift -o bin/$f || exit 1; done",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "onnxruntime-node": "^1.30.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "onnxruntime-node": "$onnxruntime-node"
  }
}
